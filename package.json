{
  "name": "freecontrol",
  "version": "2.5.1",
  "description": "FreeControl - scrcpy launcher (Windows)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "check:i18n:proto": "node --experimental-strip-types scripts/check-proto-i18n.mjs",
    "icons": "node scripts/sync-icons.mjs",
    "icons:ui": "node scripts/gen-icon-subset.mjs",
    "check:icons": "node scripts/gen-icon-subset.mjs --check",
    "check:version": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "notes": "node scripts/release-notes.mjs",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "app:stop": "powershell -NoProfile -Command \"$pids = @(Get-NetTCPConnection -LocalPort 1420 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique); if ($pids.Count -eq 0) { Write-Output '端口 1420 未被占用'; exit 0 }; $pids | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction Stop; Write-Output ('已停止占用 1420 的进程：' + $_) }\"",
    "stop": "npm run app:stop",
    "test:rs": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:web": "node --experimental-strip-types --test \"src/lib/*.test.mjs\"",
    "verify": "npm run check:version && npm run check:icons && npm run check && npm run test:rs && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "lucide-svelte": "^0.456.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2.12.3",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
