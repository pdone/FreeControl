{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeControl",
  "mainBinaryName": "FreeControl",
  "version": "2.3.0",
  "identifier": "com.freecontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FreeControl",
        "visible": false,
        "width": 1100,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "backgroundColor": "#0b0d11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
