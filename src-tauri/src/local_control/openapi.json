{
  "openapi": "3.1.0",
  "info": {
    "title": "FreeControl Local Control API",
    "description": "本机设备状态查询、连接与断开接口；所有设备接口均要求 Bearer 认证。",
    "contact": {
      "name": "FreeControl"
    },
    "license": {
      "name": ""
    },
    "version": "1"
  },
  "paths": {
    "/v1/devices/{deviceId}/connect": {
      "post": {
        "tags": [
          "local-control"
        ],
        "summary": "使用已保存参数连接设备",
        "operationId": "connect",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "FreeControl 设备身份",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "连接处理完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalActionResult"
                }
              }
            }
          },
          "400": {
            "description": "请求格式不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "访问凭据无效或已撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Host 或 Origin 不受许可",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "设备不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "设备不可连接或操作冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "设备操作失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "本地控制服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "本地控制服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/{deviceId}/disconnect": {
      "post": {
        "tags": [
          "local-control"
        ],
        "summary": "断开设备全部运行会话",
        "operationId": "disconnect",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "FreeControl 设备身份",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "断开处理完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalActionResult"
                }
              }
            }
          },
          "400": {
            "description": "请求格式不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "访问凭据无效或已撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Host 或 Origin 不受许可",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "设备不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "设备操作冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "设备操作失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "本地控制服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "本地控制服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "tags": [
          "local-control"
        ],
        "summary": "读取设备列表与当前状态",
        "operationId": "state_handler",
        "responses": {
          "200": {
            "description": "当前设备状态快照",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalState"
                }
              }
            }
          },
          "400": {
            "description": "请求格式不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "访问凭据无效或已撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Host 或 Origin 不受许可",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "本地控制服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "本地控制服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ExternalActionResult": {
        "type": "object",
        "required": [
          "deviceId",
          "status",
          "changed"
        ],
        "properties": {
          "changed": {
            "type": "boolean"
          },
          "deviceId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warning": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ExternalDevice": {
        "type": "object",
        "required": [
          "id",
          "alias",
          "kind",
          "connectionId",
          "status"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ExternalState": {
        "type": "object",
        "required": [
          "protocolVersion",
          "statusSequence",
          "probed",
          "stale",
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalDevice"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "probed": {
            "type": "boolean"
          },
          "protocolVersion": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "stale": {
            "type": "boolean"
          },
          "statusSequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    }
  },
  "security": [
    {
      "bearer_auth": []
    }
  ],
  "tags": [
    {
      "name": "local-control",
      "description": "本机设备控制"
    }
  ]
}